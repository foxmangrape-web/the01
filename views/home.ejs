<!-- include header -->
<%- include('./include/_header') %>
<!-- /include header -->

  <!-- Main -->
  <main id="site-main">
    <div class="card form-card">
      <h2>로그인</h2>     
      <p>연락처 관리를 위해 로그인해 주세요.</p>

      <form action="/" method="POST" class="login">
        <div class="form-group">
          <label for="username">아이디</label>
          <input type="text" placeholder="사용자 아이디를 입력하세요" name="username" id="username" required>
        </div>
        <div class="form-group">
          <label for="password">비밀번호</label>
          <input type="password" placeholder="비밀번호를 입력하세요" name="password" id="password" required>
        </div>
      
        <button type="submit" class="login-btn">로그인</button>

        <div class="form-footer">
          아직 회원이 아니신가요? <a href="/register">회원가입</a>
        </div>
      </form>
    </div>
  </main>
  <!-- /Main -->

<!-- include footer -->
<%- include('./include/_footer') %>
<!-- /include footer -->