<!-- include header -->
<%- include('./include/_header') %>
<!-- /include header -->

  <!-- Main -->
  <main id="site-main">
    <div class="card form-card">
      <div class="button-box">        
        <h2>연락처 추가</h2>
        <a href="/contacts" class="btn btn-secondary">← 목록으로</a>
      </div>
      <p>새로운 연락처 정보를 입력하세요.</p>
      
      <form action="/contacts/add" method="POST" id="add-user">
        <div class="form-group">
          <label for="name">이름 (Full Name)</label>
          <input type="text" class="form-control" name="name" id="name" placeholder="홍길동" required>
        </div>
        <div class="form-group">
          <label for="email">이메일 (E-mail)</label>
          <input type="email" class="form-control" name="email" id="email" placeholder="hong@example.com">
        </div>
        <div class="form-group">
          <label for="phone">전화번호 (Mobile)</label>
          <input type="text" class="form-control" name="phone" id="phone" placeholder="010-1234-5678" required>
        </div>
        <button type="submit" class="btn btn-primary">저장하기</button>
      </form>   
    </div>
  </main>
  <!-- /Main -->

<!-- include footer -->
<%- include('./include/_footer') %>
<!-- /include footer -->