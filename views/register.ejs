<!-- include header -->
<%- include('./include/_header') %>
<!-- /include header -->

  <!-- Main -->
  <main id="site-main">
    <div class="card form-card">
      <h2>사용자 등록</h2>
      <p>새 계정을 생성하세요.</p>

      <form action="/register" method="POST" class="register">
        <div class="form-group">
          <label for="username">아이디</label>
          <input type="text" placeholder="아이디를 입력하세요" name="username" id="username" required>
        </div>
        <div class="form-group">
          <label for="password">비밀번호</label>
          <input type="password" placeholder="비밀번호를 입력하세요" name="password" id="password" required>
        </div>
        <div class="form-group">
          <label for="password2">비밀번호 확인</label>
          <input type="password" placeholder="비밀번호를 한 번 더 입력하세요" name="password2" id="password2" required>
        </div>
        <input type="submit" value="가입하기" class="register-btn">

        <div class="form-footer">
          이미 계정이 있으신가요? <a href="/">로그인</a>
        </div>
      </form>      
    </div>
  </main>
  <!-- /Main -->

<!-- include footer -->
<%- include('./include/_footer') %>
<!-- /include footer -->